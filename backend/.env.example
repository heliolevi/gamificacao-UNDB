# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env de verdade (ele já está no .gitignore).

# Connection string do Postgres (Neon). Pegue em neon.tech > seu projeto > Connection string.
# A que o Neon mostra por padrão é a "pooled" (tem "-pooler" no host) — use ela aqui.
# connection_limit/pool_timeout aumentam quantas conexões o Prisma abre em paralelo —
# importante pro dia do evento, com muita gente escaneando ao mesmo tempo.
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.aws.neon.tech/neondb?sslmode=require&connection_limit=25&pool_timeout=20"

# Mesma connection string, mas SEM "-pooler" no host — o Prisma precisa de uma
# conexão direta (não via pooler) pra rodar migrations.
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.aws.neon.tech/neondb?sslmode=require"

# Segredo usado para assinar os tokens JWT de login. Use uma string longa e aleatória em produção.
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Credenciais da conta admin criada pelo `npm run seed` (só é criada se ainda não existir).
ADMIN_EMAIL="admin@itworks.com"
ADMIN_PASSWORD="TrocarSenha@123"
